{
  "name": "solidjs-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "lint:staged": "lint-staged",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "lint:versions": "node -e \"const p=require('./package.json'),all={...p.dependencies,...p.devDependencies},bad=Object.entries(all).filter(([,v])=>/^[\\^~]/.test(v));if(bad.length){console.error('Non-exact versions:',bad.map(([k,v])=>k+'@'+v).join(', '));process.exit(1)}\"",
    "check": "tsc --noEmit && oxlint src && oxfmt --check src && pnpm lint:versions",
    "storybook": "storybook dev",
    "build-storybook": "storybook build",
    "bundlewatch": "bundlewatch --config .bundlewatchrc",
    "deps:upgrade": "ncu -u && pnpm install",
    "prepare": "husky"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "1.0.0",
    "@solidjs/start": "2.0.5",
    "@vanilla-extract/css": "1.21.2",
    "@vanilla-extract/sprinkles": "1.7.1",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "polished": "4.3.1",
    "schema-dts": "2.0.0",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.1",
    "@faker-js/faker": "10.6.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@types/node": "26.6.3",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "bundlewatch": "0.4.2",
    "eslint-plugin-solid": "0.18.0",
    "husky": "9.1.7",
    "idb": "8.0.3",
    "lint-staged": "17.6.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "npm-check-updates": "23.1.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "picocolors": "1.1.1",
    "playwright": "1.63.0",
    "rolldown": "1.2.11",
    "rollup-plugin-visualizer": "7.1.1",
    "storybook": "10.6.0",
    "storybook-solidjs-vite": "10.7.2",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-compression2": "2.5.3",
    "vite-plugin-oxlint": "2.2.0",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  }
}
